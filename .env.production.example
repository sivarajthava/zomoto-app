# Production Environment Configuration Template
# Set these variables in Railway Project Settings -> Variables

# Groq Cloud API Key (Required for live AI reasoning)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Runtime Environment
ENVIRONMENT=production

# Server Configuration (Railway automatically sets PORT)
PORT=8000
APP_HOST=0.0.0.0

# Dataset Path (Bundled 2.46MB Parquet)
DATA_PATH=data/processed/zomato_clean.parquet

# Model & Reasoning Parameters
DEFAULT_LLM_MODEL=openai/gpt-oss-120b
REQUEST_TIMEOUT_SECONDS=6.0
MAX_CANDIDATES_STAGE_1=15
MIN_CANDIDATES_THRESHOLD=5
