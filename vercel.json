{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/meta",
      "destination": "https://zomoto-app-production.up.railway.app/api/v1/metadata"
    },
    {
      "source": "/api/recommend",
      "destination": "https://zomoto-app-production.up.railway.app/api/v1/recommendations"
    },
    {
      "source": "/api/:path*",
      "destination": "https://zomoto-app-production.up.railway.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://zomoto-app-production.up.railway.app/health"
    },
    {
      "source": "/docs",
      "destination": "https://zomoto-app-production.up.railway.app/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://zomoto-app-production.up.railway.app/openapi.json"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/static/:path*",
      "destination": "/app/static/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/app/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}